# Публичный URL backend API для браузерного axios/Orval client
NEXT_PUBLIC_API_URL=http://localhost:4000

# OpenAPI-схема бэкенда (файл появляется после запуска backend) для генерации shared/api/generated.ts через Orval
ORVAL_PATH_URL=../backend/uploads/openapi/openapi-spec.json

# Демо-режим: кнопки входа в демо-аккаунты (false — скрыть, например в продакшене)
NEXT_PUBLIC_DEMO_MODE=true
