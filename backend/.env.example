NODE_ENV=development
PORT=4000
API_PREFIX=api
ALLOWED_ORIGIN=http://localhost:3000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dalago
# Docker: порт 5432. Без Docker: pnpm db:local (порт из POSTGRES_PORT).
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dalago?schema=public
JWT_SECRET=change-me-to-a-long-random-string
# Срок жизни access-токена (refresh-токенов в MVP нет)
JWT_EXPIRES_IN_SECONDS=604800

# ИИ: создание объявлений и поиск обычным языком.
# Без ключа работает резервный режим на правилах (он явно помечен в интерфейсе).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
AI_RATE_LIMIT_PER_MINUTE=15

OPENAPI_TITLE=Документация DalaGo API
OPENAPI_VERSION=0.1
OPENAPI_OUTPUT_PATH="./uploads/openapi"

SEED_ON_BOOT=false
SEED_ALLOW_PRODUCTION=false
SEED_ADMIN_EMAIL=admin@dalago.kz
SEED_ADMIN_NAME=Admin
