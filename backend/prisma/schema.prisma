generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  BUYER
  SUPPLIER
  ADMIN
}

enum Language {
  kk
  ru
}

enum CompanyType {
  FARM
  PRODUCER
  PROCESSOR
  SHOP
  CAFE
  RESTAURANT
  CANTEEN
  WHOLESALE
}

enum Unit {
  KG
  T
  L
  PCS
  PACK
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum RequestStatus {
  OPEN
  OFFERS_RECEIVED
  ACCEPTED
  CLOSED
}

enum OfferStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model User {
  id                String   @id @default(uuid())
  email             String   @unique
  name              String
  passwordHash      String?
  role              UserRole @default(BUYER)
  preferredLanguage Language @default(kk)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  company  Company?
  messages InquiryMessage[]

  @@map("users")
}

/// Регионы: на старте активна только область Абай, остальные — для масштабирования.
model Region {
  id        String  @id
  nameRu    String
  nameKk    String
  isActive  Boolean @default(false)
  sortOrder Int     @default(0)

  cities City[]

  @@map("regions")
}

/// Города и районные центры. Координаты — приблизительный центр населённого пункта.
model City {
  id        String  @id
  regionId  String
  nameRu    String
  nameKk    String
  latitude  Float?
  longitude Float?
  sortOrder Int     @default(0)

  region    Region            @relation(fields: [regionId], references: [id])
  companies Company[]
  products  Product[]
  requests  PurchaseRequest[]

  @@index([regionId])
  @@map("cities")
}

model Category {
  id        String @id @default(uuid())
  slug      String @unique
  nameRu    String
  nameKk    String
  icon      String
  sortOrder Int    @default(0)

  products Product[]
  requests PurchaseRequest[]

  @@map("categories")
}

model Company {
  id          String      @id @default(uuid())
  ownerUserId String      @unique
  name        String
  type        CompanyType
  description String?
  cityId      String
  address     String?
  phone       String
  isDemo      Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  owner             User              @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  city              City              @relation(fields: [cityId], references: [id])
  products          Product[]
  requests          PurchaseRequest[]
  offers            Offer[]
  inquiriesStarted  Inquiry[]         @relation("InquiryFrom")
  inquiriesReceived Inquiry[]         @relation("InquiryTo")

  @@index([cityId])
  @@index([type])
  @@map("companies")
}

model Product {
  id                String        @id @default(uuid())
  supplierCompanyId String
  categoryId        String
  title             String
  titleKk           String?
  description       String
  descriptionKk     String?
  price             Decimal       @db.Decimal(12, 2)
  currency          String        @default("KZT")
  unit              Unit
  availableQty      Decimal       @db.Decimal(12, 2)
  minOrderQty       Decimal       @db.Decimal(12, 2)
  cityId            String
  deliveryAvailable Boolean       @default(false)
  pickupAvailable   Boolean       @default(true)
  imageUrl          String?
  tags              String[]      @default([])
  /// Нормализованный текст для поиска: названия ru/kk, описание, теги, категория.
  searchText        String        @default("")
  status            ProductStatus @default(ACTIVE)
  isDemo            Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  supplier  Company   @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  category  Category  @relation(fields: [categoryId], references: [id])
  city      City      @relation(fields: [cityId], references: [id])
  offers    Offer[]
  inquiries Inquiry[]

  @@index([status, categoryId])
  @@index([cityId])
  @@index([price])
  @@index([supplierCompanyId])
  @@map("products")
}

/// Оптовая заявка покупателя. Жизненный цикл: OPEN → OFFERS_RECEIVED → ACCEPTED | CLOSED.
model PurchaseRequest {
  id              String        @id @default(uuid())
  buyerCompanyId  String
  categoryId      String?
  title           String
  description     String?
  quantity        Decimal       @db.Decimal(12, 2)
  unit            Unit
  targetPrice     Decimal?      @db.Decimal(12, 2)
  currency        String        @default("KZT")
  deliveryCityId  String
  deliveryAddress String?
  desiredDate     DateTime
  status          RequestStatus @default(OPEN)
  isDemo          Boolean       @default(false)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  closedAt        DateTime?

  buyer        Company   @relation(fields: [buyerCompanyId], references: [id], onDelete: Cascade)
  category     Category? @relation(fields: [categoryId], references: [id])
  deliveryCity City      @relation(fields: [deliveryCityId], references: [id])
  offers       Offer[]
  inquiries    Inquiry[]

  @@index([status, createdAt])
  @@index([buyerCompanyId])
  @@map("purchase_requests")
}

model Offer {
  id                    String      @id @default(uuid())
  requestId             String
  supplierCompanyId     String
  productId             String?
  quantity              Decimal     @db.Decimal(12, 2)
  pricePerUnit          Decimal     @db.Decimal(12, 2)
  currency              String      @default("KZT")
  deliveryCost          Decimal?    @db.Decimal(12, 2)
  estimatedDeliveryDate DateTime
  terms                 String?
  status                OfferStatus @default(PENDING)
  isDemo                Boolean     @default(false)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  request  PurchaseRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  supplier Company         @relation(fields: [supplierCompanyId], references: [id], onDelete: Cascade)
  product  Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@unique([requestId, supplierCompanyId])
  @@index([supplierCompanyId])
  @@map("offers")
}

/// Обращение (переписка) между двумя компаниями, опционально по товару или заявке.
model Inquiry {
  id            String   @id @default(uuid())
  fromCompanyId String
  toCompanyId   String
  productId     String?
  requestId     String?
  subject       String
  isDemo        Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  fromCompany Company          @relation("InquiryFrom", fields: [fromCompanyId], references: [id], onDelete: Cascade)
  toCompany   Company          @relation("InquiryTo", fields: [toCompanyId], references: [id], onDelete: Cascade)
  product     Product?         @relation(fields: [productId], references: [id], onDelete: SetNull)
  request     PurchaseRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)
  messages    InquiryMessage[]

  @@index([fromCompanyId])
  @@index([toCompanyId])
  @@map("inquiries")
}

model InquiryMessage {
  id           String   @id @default(uuid())
  inquiryId    String
  authorUserId String
  body         String
  createdAt    DateTime @default(now())

  inquiry Inquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([inquiryId, createdAt])
  @@map("inquiry_messages")
}
